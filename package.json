{
  "name": "dezignmail",
  "version": "2.0.0",
  "description": "Dezignmail - Temporary Email Service (Cloudflare Pages + D1 + R2 + Email Routing)",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev dist --compatibility-date=2024-09-23",
    "dev:sandbox": "vite build && wrangler pages dev dist",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "vite build && wrangler pages deploy dist --project-name dezignmail",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create dezignmail-d1",
    "db:schema": "wrangler d1 execute dezignmail-d1 --file sql/schema.sql --remote",
    "db:indexes": "wrangler d1 execute dezignmail-d1 --file sql/indexes.sql --remote",
    "r2:create": "wrangler r2 bucket create dezignmail-attachments",
    "r2:create-preview": "wrangler r2 bucket create dezignmail-attachments-preview"
  },
  "dependencies": {
    "hono": "^4.7.11",
    "postal-mime": "^2.7.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "@types/node": "^26.2.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "wrangler": "^3.78.0"
  },
  "type": "module"
}
