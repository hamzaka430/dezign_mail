# Dezignmail v2 — Local dev vars (copy to .dev.vars, never commit .dev.vars)
# D1 and R2 bindings are configured in wrangler.toml — no connection string needed.

ALLOWED_DOMAINS=healthtek.eu.cc
HOURS_TO_DELETE=3

# Optional: Telegram notifications for cron cleanup
TELEGRAM_LOG_ENABLE=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
